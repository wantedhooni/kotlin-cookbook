# mock | http
DBS_MODE=mock
DBS_BASE_URL=https://www.dbs.com/sandbox
DBS_CLIENT_ID=replace-me
DBS_ACCESS_TOKEN=replace-me
DBS_ACCEPT_VERSION=application/json;v=1.0

# The DBS Deposit documentation page is dynamically rendered.
# Verify these paths against the sandbox documentation available to your DBS developer account.
DBS_LIST_DEPOSITS_PATH=/api/sg/v1/parties/{partyId}/deposits
DBS_DEPOSIT_DETAIL_PATH=/api/sg/v1/deposits/{accountId}

SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://localhost:5432/dbs_deposit
DB_USERNAME=dbs
DB_PASSWORD=dbs
